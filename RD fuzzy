	* 6.5 Compliers information
	gen tomar_PC = (PMA>=79 & Precalculo==1 & PMA!=.)
	gen omite_PC = (PMA<79 & Precalculo==0)
	gen nocomplier= tomar_PC+omite_PC
	count if nocomplier==1
	scalar total_nocomplier = `r(N)'
	
	* Obtener el número de incumplidores como proporción de la muestra total
	count if tomar_PC==1
	dis (`r(N)'/_N)*100
	dis (`r(N)'/(total_nocomplier))*100
	count if omite_PC==1
	dis (`r(N)'/_N)*100
	dis (`r(N)'/total_nocomplier)*100
	
	
	graph bar (sum) tomar_PC omite_PC, legend(order(1 "Tomar Preca" 2 "Omite Preca") ///
	position(6) col(2) size(small)) ///
	ytitle("Número de estudiantes")  ///
	title("Número de non-compliers por tipo de incumplimiento") ///
	note("Tomar Preca cuando no debe: 4.77% (muestra) 39.2% (non-compliance).", size(small)) caption("Omitir Preca cuando debe: 7.4% (muestra) 60.8% (non-compliance).", size(small)) blabel(bar)
	*graph export "${ResultadosRD}/incumplimiento/incumplimiento-tipo-allsample.png", as(png) replace
	
	* Incumplimiento por tipo de calendario sobre muestra completa
	count if nocomplier ==1 & calendario!=""
	scalar total_nocomplier_calendario = `r(N)'
	
	count if calendario=="A" &  tomar_PC==1
	dis (`r(N)'/total_nocomplier_calendario)*100
	count if calendario=="A" &  omite_PC==1
	dis (`r(N)'/total_nocomplier_calendario)*100
	count if calendario=="B" &  tomar_PC==1
	dis (`r(N)'/total_nocomplier_calendario)*100
	count if calendario=="B" &  omite_PC==1
	dis (`r(N)'/total_nocomplier_calendario)*100
	
	graph bar (sum) tomar_PC omite_PC, over(calendario) legend(order(1 "Tomar Preca" 2 "Omite Preca") position(6) col(2)) ///
	ytitle("Número de estudiantes") blabel(bar)  ///
	title("Número de non-compliers por tipo de incumplimiento y calendario") ///
	note("Tomar Preca cuando no debe: 25.29% (Calendario A) 12.77% (Calendario B).", size(small)) ///
	caption("Omitir Preca: 32.62% (Calendario A) 29.29% (Calendario B).", size(small))
	*graph export "${ResultadosRD}/incumplimiento/incumplimiento-calendario-allsample.png", as(png) replace
	
	*** Incumplimiento sobre total de personas a un lado del umbral
	
	* Izquierda del umbral (completo)
	count if PMA<79
	scalar no_toma=`r(N)'
	count if PMA<79 & Precalculo==0
	scalar incumplimiento_left = (`r(N)'/no_toma)*100

	* Izquierda del umbral (10 puntos abajo)
	count if PMA<79 & PMA>=69
	scalar no_toma_u=`r(N)'
	count if PMA<79 & PMA>=69 & Precalculo==0
	scalar incumplimiento_left_umbral = (`r(N)'/no_toma_u)*100
	
	* Derecha del umbral (completo)
	count if PMA>=79 & PMA!=.
	scalar toma=`r(N)'
	count if PMA>=79 & PMA!=. & Precalculo==1
	scalar incumplimiento_right = (`r(N)'/toma)*100
	
	* Derecha del umbral (10 puntos arriba)
	count if PMA>=79 & PMA<=89 & PMA!=.
	scalar toma_u=`r(N)'
	count if PMA>=79 & PMA<=89 & PMA!=. & Precalculo==1
	scalar incumplimiento_right_umbral = (`r(N)'/toma_u)*100
	
	preserve
	clear
	set obs 2
	gen id = _n
	gen codigo = "" 
	replace codigo="Omitir Precálculo" if id ==1
	replace codigo="Tomar Precálculo" if id ==2
	gen value1 =.
	replace value1 = incumplimiento_left if codigo=="Omitir Precálculo"
	replace value1 = incumplimiento_right if codigo=="Tomar Precálculo"
	gen value2 =.
	replace value2 = incumplimiento_left_umbral if codigo=="Omitir Precálculo"
	replace value2 = incumplimiento_right_umbral if codigo=="Tomar Precálculo"
	graph bar value1 value2, over(codigo)  ytitle("Porcentaje (%)") ///
	title("Porcentaje de 'Non compliers'") bar(1, fcolor(navy%50)) ///
	bar(2, fcolor(red%50)) legend(position(6) c(2) ///
	order(1 "Incumplimiento - total" 2 "Incumplimiento - umbral")) ylabel(0(5)20) blabel(bar) ///
	note ("Para el umbral se toma un ancho de banda de 10 puntos.")
	*graph export "${ResultadosRD}/incumplimiento/total-no-compliers.png", as(png) replace
	restore
	
	
