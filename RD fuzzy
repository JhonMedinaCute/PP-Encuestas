clear all
set more off
cap log clase
set varabbrev off


global path "/Users/`c(username)'/Library/CloudStorage/OneDrive-Universidaddelosandes/PP Math/4. Datos"
global BasesR "${path}/1. Bases_raw"
global BasesS "${path}/2. Bases_stata"
global Resultados "${path}/4. Resultados/2. Regresiones/1. Raw"
global ResultadosRD "${path}/4. Resultados/2. Regresiones/1. Raw/4.RD"
qui do "${path}/3. Códigos/TexEdits.do"


*------------------------------------------------------------------------------*
**# 1) Import data
*------------------------------------------------------------------------------*

use "${BasesS}/base_regresiones", clear

*br if PERIODO==202120

tab PERIODO

*------------------------------------------------------------------------------*
**# 2) Clean data
*------------------------------------------------------------------------------*

	drop if PERIODO < 201510 
	
	* Drop semesters with no data 
	
	gen ultimos=substr(periodo_s,5,.)
	drop if ultimos=="19"
	destring ESTRATO, replace
	
	sort CODIGO_ESTUDIANTE PERIODO 
	* Left the first time someone took CD
	duplicates tag CODIGO_ESTUDIANTE, gen(tag)
	tab tag
	drop tag
	gen muestra = (PERIODO==CD_primeravez)

	* Keep people the first time they took CD
	keep if muestra==1
	*duplicates report CODIGO_ESTUDIANTE
	
*------------------------------------------------------------------------------*
**# 3) Gráfico para ver la probabilidad de tratamiento
*------------------------------------------------------------------------------*

	replace PMA=. if PMA==0 //corregir el cambio que hago para ordenar en el dofile de descriptivas

	tw (scatter Precalculo PMA) (lfit Precalculo PMA if PMA<=79) (lfit Precalculo PMA if PMA>79), ///
	xline(79) ytitle("Probabilidad de tomar precálculo") xtitle("Puntaje en matemáticas") ///
	legend(order(1 "(1) tomó precálculo (0) no" 2 "Discontinuidad en" 3 "probabilidad de ser tratado")) ///
	title("Cambio en la probabilidad de ser tratado (ver precálculo)") ///
	note("Se grafican la linea de tendencia antes y después de 79 puntos.")
	*graph export "${ResultadosRD}/probabilidad_ser_tratado.png", as(png) replace
	
	
*------------------------------------------------------------------------------*
**# 4) Generar variable de elegibilidad
*------------------------------------------------------------------------------*
	
	gen mandatoryPC = (PMA<79)
	tab mandatoryPC Precalculo
	
*------------------------------------------------------------------------------*
**# 5) Grafico para ver la probabilidad de tratamiento
*------------------------------------------------------------------------------*

* 5.1 Discontinuidad en la probabilidad de tratamiento	
	reghdfe Precalculo mandatoryPC##c.PMA, a(PERIODO)			///
		vce(robust)
	
	di "El salto en la probabilidad de tratamiento es de " 						///
		string(_b[1.mandatoryPC]*100,"%6.3f") " puntos porcentuales "		///
		"y el p-valor de la prueba de significancia individual es de " 			///
		string(ttail(e(df_r),abs(_b[1.mandatoryPC]/_se[1.mandatoryPC]))*2, ///
		"%6.3f")
	
	

* 5.2 No manipulación de la variable de focalización
	*ssc install rddensity	

	rddensity PMA, c(79) plot graph_opt(title("Test manipulación en el umbral (79 puntos)") ///
	legend(off) xtitle("Puntaje en matemáticas") ytitle("Densidad")) 
	*graph export "${ResultadosRD}/manipulacion.png", as(png) replace
	
	sum PMA, d
	hist PMA, xline(79) xtitle("Puntaje en matemáticas") ytitle("Densidad") ///
	title("Histograma puntaje en matemáticas") xlabel(10(5)100) ///
	note("Media: 77.71. Desv. est: 12.38") color(blue%50)
	*graph export "${ResultadosRD}/histogram_PMA.png", as(png) replace
	
* Check manipulation by years

	global semestre 201510 201520 201610 ///
	201620 201710 201720 201810 201820 201910 ///
	201920 202020 202110 202120 202210 202220 202310 202320 202410
	
	foreach x of global semestre {
	preserve
	keep if PERIODO == `x'	
	rddensity PMA, c(79) plot graph_opt(title("Test manipulación en el umbral. Semestre `x'") ///
	legend(off) xtitle("Puntaje en matemáticas") ytitle("Densidad")) 
	*graph export "${ResultadosRD}/histogram_PMA_`x'.png", as(png) replace
	restore
	}
	
	
